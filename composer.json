{
    "name": "sophialabs/cronos-flow-sdk",
    "description": "SDK oficial da API publica do CronosFlow: envio de WhatsApp com ritmo seguro, idempotencia e repeticao controlada.",
    "type": "library",
    "keywords": ["whatsapp", "cronosflow", "sdk", "mensageria", "api"],
    "homepage": "https://cronosflow.sophialabs.com.br/docs/api",
    "license": "proprietary",
    "authors": [
        {
            "name": "Team Sophia",
            "email": "contato@sophialabs.com.br",
            "homepage": "https://cronosflow.sophialabs.com.br",
            "role": "Mantenedor"
        }
    ],
    "support": {
        "docs": "https://cronosflow.sophialabs.com.br/docs/api",
        "issues": "https://github.com/SophiaLab/cronos_php_sdk/issues",
        "email": "contato@sophialabs.com.br"
    },
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SophiaLabs\\CronosFlow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SophiaLabs\\CronosFlow\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit"
    }
}
